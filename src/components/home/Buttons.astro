---
const buttons: {
    imageURL: string;
    siteURL: string;
}[] = [
    {
        imageURL: "/buttons/azzy.png",
        siteURL: "https://astrid.sh/",
    },
    {
        siteURL: "https://lily.pet/",
        imageURL: "https://lily.pet/assets/badges/lily_pet.gif",
    },
    {
        siteURL: "https://aroze.me/",
        imageURL: "https://aroze.me/images/88x31/aroze.png",
    },

    {
        imageURL: "https://kibty.town/files/img/buttons/kibty.town-badge.gif",
        siteURL: "https://kibty.town/",
    },
    {
        imageURL: "https://jamie.rs/images/jamie.rs-badge.png",
        siteURL: "https://jamie.rs/",
    },

];
---

<div class="flex justify-start items-center mt-[2rem]">
    <div class="flex flex-wrap">
        {
            buttons.map((link) => {
                return (
                        <a class="inline-flex mx-2 mb-4 sm:mb-0" href={link.siteURL}>
                            <img src={link.imageURL} alt={link.siteURL}/>
                        </a>
                );
            })
        }
    </div>
</div>