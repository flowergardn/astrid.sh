---
const buttons: {
    imageURL: string;
    siteURL: string;
}[] = [
    {
        siteURL: "https://astrid.sh/",
        imageURL: "/buttons/astrid-badge.png",
    },
    {
        siteURL: "https://lumienescence.neocities.org/",
        imageURL: "/buttons/lumie-badge.png",
    },
    {
        siteURL: "https://aroze.me/",
        imageURL: "/buttons/aroze-badge.png",
    },
    {
        siteURL: "https://lily.pet/",
        imageURL: "/buttons/lily-badge.gif",
    },
    {
        siteURL: "https://kibty.town/",
        imageURL: "/buttons/eva-badge.gif",
    },
    {
        siteURL: "https://jamie.rs/",
        imageURL: "/buttons/jamie-badge.png",
    },
];
---

<div class="flex justify-start items-center mt-[2rem]">
    <div class="flex flex-wrap">
        {
            buttons.map((link) => {
                return (
                        <a class="inline-flex mx-2 mb-4 sm:mb-0" href={link.siteURL}>
                            <img src={link.imageURL} alt={link.siteURL}/>
                        </a>
                );
            })
        }
    </div>
</div>
