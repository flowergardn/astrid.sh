            <ul class="text-text">
                <LinkItem name="email" href="mailto:me@astrid.sh" label="me at astrid.sh"/>
                <LinkItem name="discord" href="https://discord.com/users/852656702037164053" label="@flowergardn"/>
                <LinkItem name="bluesky" href="https://bsky.app/profile/astrid.sh"/>
                <LinkItem name="github" href="https://github.com/flowergardn"/>
                <LinkItem name="lastfm" href="https://www.last.fm/user/flowergardn"/>
            </ul>
    </Page>
</Layout>
