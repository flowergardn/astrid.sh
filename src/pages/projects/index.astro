---
import Navbar from '~/components/Navbar.tsx';
import {getCollection} from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import { render } from 'astro:content';
import ProjectItem from '~/components/blog/ProjectItem';
import Page from '~/components/Page.astro';

const posts = await getCollection('project');
let sorted = posts.filter((p) => !p.data.unlisted);
---

<Layout>
    <Page>
            <Navbar currentPage={Astro.url.pathname} />
            <div id="content" class="p-2 text-text">
                <p>Projects I've worked on</p>

                <ul class="text-text">
                    {sorted.map(async (post) => {
                        const { remarkPluginFrontmatter } = await render(post);
                        const info = {
                          title: post.data.title,
                          description: post.data.description,
                          url: `/projects/${post.id}`,
                          minutesRead: remarkPluginFrontmatter.minutesRead
                        }
                        return (<ProjectItem info={info}/>)
                      }
                    )}
                </ul>
            </div>
    </Page>
</Layout>;
