---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ky from "ky";
import Buttons from "../components/Buttons.astro";
import Status from "../components/Status";

type UserInfo = {
    status: string;
    activities: any[];
    avatar: string;
    displayName: string;
    username: string;
};

type AgeResponse = {
    age: number;
    nextBirthday: string;
};


const userInfo: UserInfo = await ky.get("https://astrid.sh/discord").json<UserInfo>();
const ageResponse: AgeResponse = await ky.get("https://age.astrid.sh/11/19/03").json<AgeResponse>();
---

<Layout>
    <div class="flex center items-center justify-center h-screen">
        <div class="bg-surface text-gray-800 w-full md:w-[50vw] min-h-[35vh] rounded-lg shadow-md" id="container">
            <Navbar currentPage={Astro.url.pathname}/>
            <div id="content" class="p-6 text-text">
                <div id="user-info" class="flex">
                    <img src={userInfo.avatar} class="w-24 h-24" alt="Profile picture of Astrid"/>
                    <div class="ml-4 ">
                        <div class="flex items-center space-x-2">
                            <Status status={userInfo.status} client:load />
                            <p class="text-body">{userInfo.displayName}</p>
                        </div>
                        <p class="text-body">she/her - {ageResponse.age} years old</p>
                        <section class="flex mt-4 space-x-4">
                            <a href="https://github.com/flowergardn">github</a>
                            <a href="https://twitter.com/maybeastrid">twitter</a>
                            <a href="https://bsky.app/profile/astrid.sh">bluesky</a>
                        </section>
                    </div>
                </div>
                <section id="about-me" class="mt-4 ">
                    <p>
                        hii! i'm astrid (aka: flowergardn). i'm a full-stack software developer, baker, and cat lover.
                    </p>
                    <p>
                        i mostly spend my time with web development, with nextjs, drizzle, and tailwindcss. however, i also dabble in other things, like discord bots and minecraft development.
                    </p>
                    <Buttons />
                </section>
            </div>
        </div>
    </div>
</Layout>
