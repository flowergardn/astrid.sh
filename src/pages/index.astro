---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ky from "ky";
import Buttons from "../components/home/Buttons.astro";
import Status from "../components/home/Status";
import Page from '~/components/Page.astro';

type UserInfo = {
    status: string;
    activities: any[];
    avatar: string;
    displayName: string;
    username: string;
};

type AgeResponse = {
    age: number;
    nextBirthday: string;
};

const userInfo: UserInfo = await ky.get("https://astrid.sh/discord").json<UserInfo>();
const ageResponse: AgeResponse = await ky.get("https://age.astrid.sh/11/19/03").json<AgeResponse>();
---

<Layout>
    <Page>
            <Navbar currentPage={Astro.url.pathname}/>
            <div id="content" class="p-6 text-text">
                <div id="user-info" class="flex">
                    <img src={userInfo.avatar} class="w-24 h-24" alt="Profile picture of Astrid"/>
                    <div class="ml-4 ">
                        <div class="flex items-center space-x-2">
                            <Status status={userInfo.status} client:load />
                            <p class="text-body">{userInfo.displayName}<p>
                        </div>
                        <p class="text-body">she/her - {ageResponse.age} years old</p>
                        <section class="flex mt-4 space-x-4">
                            <a href="https://github.com/flowergardn">github</a>
                            <a href="https://bsky.app/profile/astrid.sh">bluesky</a>
                        </section>
                    </div>
                </div>
                <section id="about-me" class="mt-4 ">
                    <p>
                        hii! i'm astrid (aka: flowergardn). i'm a full-stack software developer, baker, reader, and lover of music.
                    </p>
                       <br/>
                    <p>
                        these days i'm mostly focused on improving my skills with backend and infrastructure, using a mix of elysia, drizzle, rabbitmq, and kubernetes (along with a million other things). i do plenty of frontend work as well, using tools such as nextjs, astro, and tailwind.
                    </p>
                    <br/>
                    <p>
                        some notable projects i've worked on include my open source <a href="https://www.tonetags.xyz/" class="project">tone tag dictionary</a> and a site to <a href="https://bday.quest/" class="project">create virtual birthday cards</a> for your friends.
                    </p>
                    <br/>
                    <p>
                      for information on my experience, whether professional or voluntary, check out the  <a href="/experience" class="project">experience</a> page.
                    </p>
                    <Buttons />
                </section>
            </div>
   <Page />
</Layout>
