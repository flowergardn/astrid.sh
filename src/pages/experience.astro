---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ExperienceList from "../components/experience/ExperienceList";
---

<Layout>
    <div class="flex center items-center justify-center h-screen">
        <div class="bg-surface  text-text w-full md:w-[55vw] min-h-[35vh] rounded-lg shadow-md" id="container">
            <Navbar currentPage={Astro.url.pathname}/>
            <div id="content" class="p-4">
                <p>Professional experience</p>
                <ExperienceList type="professional" client:load/>
            </div>
            <div id="content" class="p-4 text-text">
                <p>Voluntary experience</p>
                <ExperienceList type="voluntary"  client:load/>
            </div>
        </div>
    </div>
</Layout>
