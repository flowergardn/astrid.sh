---
import Navbar from '~/components/Navbar.tsx';
import BlogItem from "~/components/blog/BlogItem";
import {getCollection} from 'astro:content';
import Layout from '~/layouts/Layout.astro';

const posts = await getCollection('blog');
---

<Layout>
    <div class="flex center items-center justify-center h-screen">
        <div
                class="bg-surface text-gray-800 w-full md:w-[50vw] min-h-[35vh] rounded-lg shadow-md"
                id="container"
        >
            <Navbar currentPage={Astro.url.pathname} />
            <ul class="text-text">
                {posts.map((post) => (
                        <BlogItem
                                info={{
                                    title: post.data.title,
                                    description: post.data.description,
                                    createdAt: post.data.createdAt.toLocaleDateString(),
                                    url: `/blog/${post.id}`,
                                }}
                        />
                ))}
            </ul>
        </div>
    </div>
</Layout>;
