---
import Navbar from '~/components/Navbar.tsx';
import BlogItem from "~/components/blog/BlogItem";
import { RssIcon } from "lucide-react"
import {getCollection} from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import { render } from 'astro:content';
import Page from '~/components/Page.astro';

const posts = await getCollection('blog');
let sorted = posts.sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());
sorted = sorted.filter((p) => !p.data.unlisted)
---

<Layout>
    <Page>
            <Navbar currentPage={Astro.url.pathname} />
            <ul class="text-text">
                {sorted.map(async (post) => {
                const { remarkPluginFrontmatter } = await render(post);
                return (
                        <BlogItem
                                info={{
                                    title: post.data.title,
                                    description: post.data.description,
                                    createdAt: post.data.createdAt.toLocaleDateString(),
                                    url: `/blog/${post.id}`,
                                    minutesRead: remarkPluginFrontmatter.minutesRead
                                }}
                        />
                )})}
            </ul>
            <a href="/rss.xml" class="fixed bottom-4 right-4 text-text/40 hover:text-text transition-colors">
                <RssIcon/>
            </a>
    </Page>
</Layout>;
